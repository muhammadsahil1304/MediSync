<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- NORMAL SCREEN -->
        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- TOP BAR -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_quickaction_medi"
                            android:padding="5dp"
                            android:src="@drawable/people" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="MediTrack"
                            android:textColor="#0A70A2"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgSearch"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/search"
                        app:tint="#444444" />

                </LinearLayout>

                <!-- TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="CLINICAL TOOL"
                    android:textColor="#4E97C2"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PrescriptionBoard"
                    android:textColor="#222222"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <!-- FORM -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#EFEFEF"
                    app:cardCornerRadius="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FULL PATIENT NAME"
                            android:textColor="#7B7B7B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:layout_marginTop="10dp"
                            app:cardCornerRadius="14dp">

                            <EditText
                                android:id="@+id/etPatientName"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:gravity="center_vertical"
                                android:hint="e.g. Jonathan Aris"
                                android:paddingHorizontal="16dp" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- DRAWING AREA -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="28dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <com.example.newmedisync.views.DrawingView
                            android:id="@+id/drawingView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_drawing_dots" />

                        <!-- TOOLBAR -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="270dp"
                            android:layout_height="56dp"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="14dp"
                            app:cardCornerRadius="28dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:id="@+id/btnPen"
                                    android:layout_width="42dp"
                                    android:layout_height="42dp"
                                    android:background="@drawable/bg_pen_selected"
                                    android:padding="10dp"
                                    android:src="@drawable/pen"
                                    app:tint="#FFFFFF" />

                                <ImageView
                                    android:id="@+id/btnErase"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="18dp"
                                    android:src="@drawable/eraser"
                                    app:tint="#777777" />

                                <ImageView
                                    android:id="@+id/btnClear"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="18dp"
                                    android:src="@drawable/delete"
                                    app:tint="#777777" />

                                <ImageView
                                    android:id="@+id/btnFullscreen"
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="18dp"
                                    android:src="@drawable/full_screen"
                                    app:tint="#777777" />

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="24dp"
                                    android:layout_marginHorizontal="16dp"
                                    android:background="#DDDDDD" />

                                <View
                                    android:id="@+id/blueColor"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:background="@drawable/bg_blue_dot" />

                                <View
                                    android:id="@+id/redColor"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="12dp"
                                    android:background="@drawable/bg_red_dot" />

                            </LinearLayout>

                        </androidx.cardview.widget.CardView>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

        <!-- FULLSCREEN MODE -->
        <FrameLayout
            android:id="@+id/fullscreenContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:visibility="gone">

            <com.example.newmedisync.views.DrawingView
                android:id="@+id/fullscreenDrawingView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_drawing_dots" />

            <!-- FULLSCREEN TOOLBAR -->
            <androidx.cardview.widget.CardView
                android:layout_width="320dp"
                android:layout_height="58dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="30dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/fullBlue"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_blue_dot" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <ImageView
                        android:id="@+id/fullRed"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_red_dot" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="1dp" />

                    <ImageView
                        android:id="@+id/fullErase"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/eraser"
                        app:tint="#666666" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="1dp" />

                    <ImageView
                        android:id="@+id/fullClear"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/delete"
                        app:tint="#666666" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="1dp" />

                    <ImageView
                        android:id="@+id/btnCloseFullscreen"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/cancel"
                        app:tint="#222222" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </FrameLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>